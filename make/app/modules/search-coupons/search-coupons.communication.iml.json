{
  "url": "/v1/coupons/",
  "method": "GET",
  "qs": {
    "limit": "100",
    "search": "{{parameters.search}}"
  },
  "response": {
    "iterate": "{{body.data}}",
    "output": "{{item}}",
    "limit": "{{parameters.limit}}"
  },
  "pagination": {
    "qs": {
      "starting_after": "{{last(body.data).id}}"
    },
    "condition": "{{body.has_more}}"
  }
}

{
  "url": "/v1/coupons/",
  "method": "GET",
  "qs": {
    "limit": "100"
  },
  "response": {
    "iterate": "{{body.data}}",
    "output": {
      "label": "{{item.label}} ({{item.code}})",
      "value": "{{item.id}}"
    },
    "limit": 300
  },
  "pagination": {
    "qs": {
      "starting_after": "{{last(body.data).id}}"
    },
    "condition": "{{body.has_more}}"
  }
}

{
  "condition": "{{body.event != 'webhook.test' && (webhook.token == null || headers.`x-make-token` == webhook.token)}}",
  "respond": {
    "status": 200,
    "type": "json",
    "body": {
      "received": true
    }
  },
  "output": {
    "event": "{{body.event}}",
    "eventId": "{{body.eventId}}",
    "timestamp": "{{body.timestamp}}",
    "sellerId": "{{body.sellerId}}",
    "ticket": "{{body.data.ticket}}"
  }
}

# Copy to .env for local runs. .env is gitignored: never commit it.

# Base URL the triggers and the auth test call: the API origin plus /api/v1, no trailing slash.
# Requests go to ${API_URL}/zapier/v2/<resource>.
# On Zapier this is set per version with `zapier-platform env:set <version> API_URL=...`.
# Production: the API origin plus /api/v1, the same value as the live version's environment.
# Local instance stack N: http://localhost:810N/api/v1
API_URL=http://localhost:8101/api/v1

# Optional live tests (npm run test:live). Both must be set or the live tests are skipped.
# The key is a seller API key for the API at ZAPIER_LIVE_API_URL.
ZAPIER_LIVE_API_URL=
ZAPIER_LIVE_API_KEY=
